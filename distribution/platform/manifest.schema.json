{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Letkite OS adapter registry v1",
  "type": "object",
  "required": ["schema_version", "adapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "adapters": {"type":"array", "minItems":1, "items": {
      "type":"object", "additionalProperties":false,
      "required":["id","family","packaging_backends","builder_availability","package_trust_requirements","flash_safety_status","bsp_dependency","minimum_resources","integration_tier"],
      "properties": {
        "id":{"type":"string", "minLength":1},
        "family":{"type":"string", "minLength":1},
        "packaging_backends":{"type":"array", "uniqueItems":true, "items":{"enum":["apk","opkg"]}},
        "builder_availability":{"enum":["official-imagebuilder-sdk-candidate","fork-builder-requires-verification","vendor-bsp-source-build-candidate","unavailable"]},
        "package_trust_requirements":{"type":"array", "minItems":1, "items":{"type":"string"}},
        "flash_safety_status":{"enum":["requires-exact-board-version-layout-review","unverified","blocked"]},
        "bsp_dependency":{"type":["boolean","null"]},
        "minimum_resources":{"type":"object", "additionalProperties":false, "required":["ram_mib","free_storage_mib"], "properties":{"ram_mib":{"type":"integer","minimum":1},"free_storage_mib":{"type":"integer","minimum":1}}},
        "integration_tier":{"enum":["agent-only","research-only"]}
      }
    }}
  }
}
