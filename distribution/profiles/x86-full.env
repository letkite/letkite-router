# x86_64 router VM or physical soft-router; not for Xiaomi NAND devices.
TARGET="x86"
SUBTARGET="64"
PROFILE="generic"
TIER="full"
BASE_PACKAGES="luci luci-ssl ca-bundle wireguard-tools luci-proto-wireguard"
EXTRA_PACKAGES="dockerd docker luci-app-dockerman"
DOCKER_SUPPORTED="1"

# Docker + LuCI cannot fit the stock 104 MiB OpenWrt x86 root partition.
ROOTFS_MB="512"
