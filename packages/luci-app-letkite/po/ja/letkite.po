msgstr ""
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "1 day"
msgstr "1 日"

msgid "1 hour"
msgstr "1 時間"

msgid "30 minutes"
msgstr "30 分"

msgid "A duration is a number and m, h or d, e.g. 30m, 1h, 1d."
msgstr "期間は数字と m、h、d のいずれかで指定します（例: 30m、1h、1d）。"

msgid "AI assistants cannot reach this router until it is resumed."
msgstr "再開するまで、AI アシスタントはこのルーターにアクセスできません。"

msgid "AI assistants on your LetKite account could then be handed this device to work on unattended."
msgstr "LetKite アカウントの AI アシスタントに、このデバイスを無人で操作させるために引き渡せるようになります。"

msgid "AI assistants on your LetKite account could then move files between this router and the account's other devices directly, not only through LetKite's servers."
msgstr "LetKite アカウントの AI アシスタントが、このルーターとアカウントの他のデバイスの間で、LetKite のサーバーを経由せずに直接ファイルを転送できるようになります。"

msgid "Access points"
msgstr "アクセスポイント"

msgid "Agent version"
msgstr "エージェントのバージョン"

msgid "Allow direct peer-to-peer transfers with the account's other devices."
msgstr "アカウントの他のデバイスとのピアツーピアの直接転送を許可します。"

msgid "Always hidden"
msgstr "常に非表示"

msgid "Apps on screen"
msgstr "画面上のアプリ"

msgid "Cancel"
msgstr "キャンセル"

msgid "Changes are written to %s, and the agent restarts to apply them."
msgstr "変更は %s に書き込まれ、適用のためにエージェントが再起動します。"

msgid "Code expires in %d seconds."
msgstr "コードの有効期限まで %d 秒です。"

msgid "Commands and terminals"
msgstr "コマンドとターミナル"

msgid "Connected"
msgstr "接続済み"

msgid "Connection"
msgstr "接続"

msgid "Crash reports"
msgstr "クラッシュレポート"

msgid "Direct transfers"
msgstr "直接転送"

msgid "Documentation"
msgstr "ドキュメント"

msgid "Enter it at %s → Add device → Enter the code"
msgstr "%s → デバイスを追加 → コードを入力でこのコードを入力してください"

msgid "Environment variables"
msgstr "環境変数"

msgid "Exit node"
msgstr "出口ノード"

msgid "Files"
msgstr "ファイル"

msgid "Hand over"
msgstr "引き渡し"

msgid "How to edit the ceiling"
msgstr "上限ファイルの編集方法"

msgid "Install newer agent releases signed by LetKite."
msgstr "LetKite が署名した新しいエージェントをインストールします。"

msgid "Join the account's mesh network, so that its other devices can reach this one as its rules allow."
msgstr "アカウントのメッシュネットワークに参加し、ルールの範囲でほかのデバイスからアクセスできるようにします。"

msgid "Keep awake"
msgstr "スリープさせない"

msgid "Last %d lines"
msgstr "最新 %d 行"

msgid "Last error"
msgstr "直近のエラー"

msgid "Let someone at this device hand it over to AI assistants and leave. Meant for desktops; a router has no use for it."
msgstr "このデバイスの前にいる人が、AI アシスタントに引き渡して離席できるようにします。デスクトップ向けで、ルーターでは使いません。"

msgid "LetKite"
msgstr "LetKite"

msgid "Log"
msgstr "ログ"

msgid "Mesh network"
msgstr "メッシュネットワーク"

msgid "No"
msgstr "いいえ"

msgid "No log lines from the agent."
msgstr "エージェントのログはまだありません。"

msgid "Node"
msgstr "ノード"

msgid "Not connected"
msgstr "未接続"

msgid "Not running"
msgstr "停止中"

msgid "Only turn it on if you trust the people and assistants on that account."
msgstr "そのアカウントの人とアシスタントを信頼できる場合にのみオンにしてください。"

msgid "Open the dashboard"
msgstr "ダッシュボードを開く"

msgid "Other limits"
msgstr "その他の上限"

msgid "Overview"
msgstr "概要"

msgid "Pair this router"
msgstr "このルーターをペアリング"

msgid "Paired"
msgstr "ペアリング"

msgid "Paired as %s."
msgstr "%s としてペアリングしました。"

msgid "Paired."
msgstr "ペアリングしました。"

msgid "Pairing failed: %s"
msgstr "ペアリングに失敗しました: %s"

msgid "Paths no one may read or write"
msgstr "誰も読み書きできないパス"

msgid "Pause"
msgstr "一時停止"

msgid "Pause at this device"
msgstr "このデバイスでの一時停止"

msgid "Pause for"
msgstr "指定時間だけ一時停止"

msgid "Paused"
msgstr "一時停止中"

msgid "Paused until %s"
msgstr "%s まで一時停止中"

msgid "Paused until resumed"
msgstr "再開するまで一時停止中"

msgid "Pausing disconnects the agent: AI assistants cannot reach this router or its network until the time is up or it is resumed."
msgstr "一時停止するとエージェントが切断され、時間が来るか再開するまで、AI アシスタントはこのルーターとそのネットワークにアクセスできません。"

msgid "Permissions"
msgstr "権限"

msgid "Reach LetKite's servers through its access points."
msgstr "LetKite のアクセスポイント経由で LetKite のサーバーに接続します。"

msgid "Resume"
msgstr "再開"

msgid "Running"
msgstr "実行中"

msgid "Saved, but the agent did not restart, so the change is not applied yet. Restart it under System > Startup, or with /etc/init.d/letkite-agent restart."
msgstr "保存しましたが、エージェントが再起動しなかったため、変更はまだ適用されていません。「システム → スタートアップ」で再起動するか、/etc/init.d/letkite-agent restart を実行してください。"

msgid "Saved. It applies when the agent next starts."
msgstr "保存しました。エージェントの次回起動時に適用されます。"

msgid "Saved. The agent restarted to apply it."
msgstr "保存しました。エージェントが再起動して適用しました。"

msgid "Screen"
msgstr "画面"

msgid "Send the agent's crash reports to LetKite: version, system and where it failed; never commands, paths or output."
msgstr "エージェントのクラッシュレポートを LetKite に送信します：バージョン、システム、失敗した箇所のみで、コマンド、パス、出力は含みません。"

msgid "Service"
msgstr "サービス"

msgid "Set only on LetKite's own servers"
msgstr "LetKite 自身のサーバーでのみ設定されます"

msgid "Starting…"
msgstr "開始しています…"

msgid "Status"
msgstr "状態"

msgid "Switches"
msgstr "スイッチ"

msgid "Take the environment variables set in the dashboard."
msgstr "ダッシュボードで設定した環境変数を使います。"

msgid "The LetKite agent is not installed. Reinstall the letkite-agent package."
msgstr "LetKite エージェントがインストールされていません。letkite-agent パッケージを再インストールしてください。"

msgid "The LetKite agent lets AI assistants on your LetKite account reach this router and the devices behind it, within the permissions you set here."
msgstr "LetKite エージェントを使うと、LetKite アカウントの AI アシスタントが、ここで設定した権限の範囲で、このルーターとその先のデバイスにアクセスできます。"

msgid "The account's other devices, and the AI assistants using them, could then reach this router over the mesh network, as the account's rules allow."
msgstr "アカウントの他のデバイスと、それを使う AI アシスタントが、アカウントのルールの範囲でメッシュネットワーク経由でこのルーターにアクセスできるようになります。"

msgid "The agent cannot read %s, and does not start until it is fixed: %s"
msgstr "エージェントは %s を読み込めず、修正されるまで起動しません：%s"

msgid "The agent did not answer."
msgstr "エージェントが応答しませんでした。"

msgid "The agent reported no switches."
msgstr "エージェントからスイッチの報告がありません。"

msgid "The apps AI assistants may see and drive"
msgstr "AI アシスタントが見て操作できるアプリ"

msgid "The environment variables set in the dashboard would then be written on this router, for the commands AI assistants run here."
msgstr "ダッシュボードで設定した環境変数が、AI アシスタントがここで実行するコマンド用にこのルーターに書き込まれるようになります。"

msgid "The most AI assistants may ever do on this router, whatever your LetKite account allows."
msgstr "LetKite アカウントで何が許可されていても、AI アシスタントがこのルーターでできることの上限です。"

msgid "The most of the file system AI assistants may be granted"
msgstr "AI アシスタントに許可できるファイルシステムの最大範囲"

msgid "These are not on/off switches, so LuCI does not change them. Set them in /etc/letkite/ceiling.toml over SSH, then restart the agent."
msgstr "これらはオン/オフのスイッチではないため、LuCI では変更しません。SSH で /etc/letkite/ceiling.toml に設定し、エージェントを再起動してください。"

msgid "This agent version cannot change its permissions from LuCI yet; it will once it updates itself. Until then, edit /etc/letkite/ceiling.toml over SSH."
msgstr "このバージョンのエージェントは、まだ LuCI から権限を変更できません。自動更新後に可能になります。それまでは SSH で /etc/letkite/ceiling.toml を編集してください。"

msgid "This agent version does not report its full status to LuCI yet; it will once it updates itself."
msgstr "このバージョンのエージェントは、まだ LuCI に完全な状態を報告しません。自動更新後に報告するようになります。"

msgid "Try again"
msgstr "再試行"

msgid "Tunnel targets"
msgstr "トンネルの接続先"

msgid "Turn on"
msgstr "オンにする"

msgid "Turn on %s?"
msgstr "%sをオンにしますか？"

msgid "Until resumed"
msgstr "再開するまで"

msgid "Updates"
msgstr "アップデート"

msgid "Waiting for approval…"
msgstr "承認を待っています…"

msgid "What the agent wrote to the system log (logread -e letkite)."
msgstr "エージェントがシステムログに書き込んだ内容（logread -e letkite）。"

msgid "Where tunnels may connect"
msgstr "トンネルが接続できる先"

msgid "Who may pause the connection here: users or admins"
msgstr "ここで接続を一時停止できる人：users または admins"

msgid "Yes"
msgstr "はい"

msgid "Yes, as %s"
msgstr "はい（%s）"

msgid "e.g. 45m, 2h, 3d"
msgstr "例: 45m、2h、3d"

msgid "no"
msgstr "いいえ"

msgid "no ceiling"
msgstr "上限ファイルなし"

msgid "no limit"
msgstr "制限なし"

msgid "nothing"
msgstr "なし"

msgid "off, observe or act"
msgstr "off、observe、act のいずれか"

msgid "off, plugged_in or always"
msgstr "off、plugged_in、always のいずれか"

msgid "off, sandboxed or full"
msgstr "off、sandboxed、full のいずれか"

msgid "yes"
msgstr "はい"

